configuration {
  modi: "drun,run,window";
  show-icons: true;
  font: "JetBrains Mono 10";
  display-drun: "APPS";
  display-window: "WINDOWS";
}
* {
  bg: #101722;
  fg: #dce6f2;
  accent: #36e2ce;
  muted: #687b95;
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 540px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 10px;
}
mainbox { padding: 20px; spacing: 14px; }
inputbar { children: [prompt, entry]; spacing: 12px; }
prompt { text-color: @accent; }
entry { placeholder: "Search..."; placeholder-color: @muted; }
listview { lines: 8; spacing: 5px; scrollbar: false; }
element { padding: 10px; border-radius: 6px; spacing: 10px; }
element selected.normal { background-color: @accent; text-color: #101722; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
element-text selected.normal { text-color: #101722; }
