# RED TEAM LAB — i3 / X11. Mod = Windows/Super.
set $mod Mod4
font pango:DejaVu Sans Mono 10
set $rig ~/.config/i3
gaps inner 9
gaps outer 4
smart_gaps on
smart_borders on
hide_edge_borders smart
workspace_auto_back_and_forth yes
floating_modifier $mod
focus_follows_mouse no
default_border pixel 2
client.focused #ff365f #10131d #e4e8f1 #23dcc8 #ff365f
client.focused_inactive #37415a #10131d #a0abc2 #37415a #37415a
client.urgent #ff365f #ff365f #ffffff #ff365f #ff365f
client.unfocused #252d40 #10131d #7e89a3 #252d40 #252d40
client.background #10131d

bindcode $mod+36 exec kitty --config ~/.config/kitty/rig.conf
bindcode $mod+40 exec rofi -show drun -theme ~/.config/rofi/rig.rasi
bindcode $mod+56 exec firefox-esr
bindcode $mod+26 exec thunar
bindcode $mod+28 exec /home/red-team-lab/RED-TEAM-LAB/tools/telegram-desktop/Telegram/Telegram
bindcode $mod+Shift+24 kill
bindcode $mod+113 focus left
bindcode $mod+116 focus down
bindcode $mod+111 focus up
bindcode $mod+114 focus right
bindcode $mod+Shift+113 move left
bindcode $mod+Shift+116 move down
bindcode $mod+Shift+111 move up
bindcode $mod+Shift+114 move right
bindcode $mod+43 split h
bindcode $mod+55 split v
bindcode $mod+41 fullscreen toggle
bindcode $mod+39 layout stacking
bindcode $mod+25 layout tabbed
bindcode $mod+Shift+65 floating toggle
bindcode $mod+65 focus mode_toggle
bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4
bindcode $mod+14 workspace number 5
bindcode $mod+Shift+10 move container to workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4
bindcode $mod+Shift+14 move container to workspace number 5
bindcode $mod+Shift+54 reload
bindcode $mod+Shift+27 restart
bindcode $mod+Shift+26 exec i3-nagbar -t warning -m 'Exit i3? Save your work first.' -B 'Exit' 'i3-msg exit'
bindcode $mod+46 exec light-locker-command --lock
bindsym Print exec xfce4-screenshooter
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

bindcode $mod+27 mode resize
mode resize {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode default
    bindsym Escape mode default
}

# Retain existing network, lock, power and appearance helpers during transition.
exec --no-startup-id nm-applet
exec --no-startup-id light-locker
exec --no-startup-id xfsettingsd
exec --no-startup-id xfce4-power-manager
exec --no-startup-id /usr/lib/x86_64-linux-gnu/ukui-polkit/polkit-ukui-authentication-agent-1
exec --no-startup-id /usr/lib/x86_64-linux-gnu/xfce4/notifyd/xfce4-notifyd

# One floating visualizer, opened on demand.
for_window [class="^rig-cava$"] floating enable, resize set 720 250, move position center
for_window [window_role="pop-up"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable
bindcode $mod+Shift+55 exec ~/.config/i3/scripts/actions.sh cava
bindcode $mod+Shift+31 exec ~/.config/i3/scripts/actions.sh dashboard
bindcode $mod+Shift+40 exec rofi -show window -theme ~/.config/rofi/rig.rasi
exec_always --no-startup-id ~/.config/i3/scripts/session.sh
